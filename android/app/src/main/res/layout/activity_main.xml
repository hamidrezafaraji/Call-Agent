<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <LinearLayout
            android:id="@+id/revoked_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/revoked"
                android:textColor="@color/bad" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reactivate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reactivate" />
        </LinearLayout>

        <!-- permissions -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_permissions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/perm_call_log"
            style="@style/PermButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/perm_audio"
            style="@style/PermButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/perm_battery"
            style="@style/PermButton" />

        <!-- recordings -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_recordings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/check_compat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_compat" />

        <TextView
            android:id="@+id/compat_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

        <TextView
            android:id="@+id/folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pick_folder"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pick_folder" />

        <!-- queue -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_queue" />

        <TextView
            android:id="@+id/queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/last_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:id="@+id/last_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/bad"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sync_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sync_now" />
    </LinearLayout>
</ScrollView>
