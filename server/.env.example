# Copy to .env and adjust.

# Shared secret the phone app sends in the X-API-Key header. Empty = no auth (dev only).
CALLAGENT_API_KEY=change-me

# Where the SQLite database and uploaded audio files live.
CALLAGENT_DATA_DIR=data

# Whisper settings
CALLAGENT_WHISPER_MODEL=large-v3
CALLAGENT_WHISPER_DEVICE=cuda        # cuda | cpu
CALLAGENT_WHISPER_COMPUTE=float16    # float16 on GPU, int8 on CPU
CALLAGENT_LANGUAGE=fa

# Seconds the worker sleeps when the queue is empty
CALLAGENT_POLL_SECONDS=5
