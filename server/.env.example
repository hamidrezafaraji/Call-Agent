# Copy to .env and adjust.

# Key for the admin page (/admin) and CRM integrations (X-API-Key header).
# Empty = a random key is generated on first run and saved to <data dir>/admin.key
CALLAGENT_ADMIN_KEY=

# Address phones use to reach this server, e.g. http://192.168.1.10:8100
# Empty = this machine's LAN IP is detected automatically.
CALLAGENT_PUBLIC_URL=
CALLAGENT_PORT=8100

# Where the SQLite database and uploaded audio files live.
CALLAGENT_DATA_DIR=data

# Whisper settings
CALLAGENT_WHISPER_MODEL=large-v3
CALLAGENT_WHISPER_DEVICE=cuda        # cuda | cpu
CALLAGENT_WHISPER_COMPUTE=float16    # float16 on GPU, int8 on CPU
CALLAGENT_LANGUAGE=fa

# Seconds the worker sleeps when the queue is empty
CALLAGENT_POLL_SECONDS=5
